{
  "name": "obsidian-gherkin-highlighter",
  "version": "1.0.0",
  "description": "Gherkin (Cucumber) syntax highlighting for Obsidian code blocks and .feature files",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "gherkin",
    "cucumber",
    "bdd",
    "syntax-highlighting"
  ],
  "license": "MIT",
  "devDependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.10.2",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "^6.28.0",
    "@types/node": "^20.14.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.5",
    "obsidian": "^1.5.7",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
